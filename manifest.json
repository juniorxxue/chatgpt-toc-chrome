{
  "manifest_version": 3,
  "name": "ChatGPT Answer TOC",
  "version": "3.0.0",
  "description": "A polished, draggable table of contents for ChatGPT prompts and answer headings.",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [],
  "host_permissions": [
    "*://chat.openai.com/*",
    "*://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://chat.openai.com/*",
        "*://chatgpt.com/*"
      ],
      "js": [
        "code.js"
      ],
      "css": [
        "code.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
